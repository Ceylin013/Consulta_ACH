@using Microsoft.AspNetCore.Components.Authorization
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/home">Consulta ACH</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span>
                Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="consultas">
                <span class="bi bi-search" aria-hidden="true"></span>
                Consultas ACH
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reportes">
                <span class="bi bi-file-earmark-bar-graph" aria-hidden="true"></span>
                Reportes
            </NavLink>
        </div>

        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="usuarios">
                        <span class="bi bi-people-fill" aria-hidden="true"></span>
                        Gestión de usuarios
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <hr class="text-white" />
        
        <div class="nav-item px-3">
            <form method="post" action="/logout" data-enhance="false" @onclick:stopPropagation="true">
                <AntiforgeryToken />

                <button type="submit" class="nav-link btn btn-link text-white">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                    Cerrar sesión
                </button>
            </form>
 
        </div>

    </nav>
</div>