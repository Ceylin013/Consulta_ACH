@page "/"
@layout LoginLayout

<PageTitle>Consulta ACH | Iniciar sesión</PageTitle>

<div class="login-container">
    <div class="login-card">

        <div class="login-header">
            <div class="login-icon">
                <i class="bi bi-bank"></i>
            </div>

            <h2>Consulta ACH</h2>
            <p>Cooperativa CAYCSOL</p>
        </div>

        <div class="login-body">

            <h5>Bienvenido</h5>
            <p class="subtitle">Ingresa tus credenciales para continuar.</p>

            <form method="post" action="/login" data-enhance="false">

                <AntiforgeryToken />

                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <input type="text" name="usuario" class="form-control" placeholder="Ingrese el nombre de su usuario"
                           required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Contraseña</label>
                    <input type="password" name="contrasena" class="form-control" placeholder="Ingrese su contraseña"
                           required />
                </div>

                <button type="submit" class="btn btn-login w-100">
                    Iniciar sesión
                </button>

                @if (Error == "invalido")
                {
                    <div class="alert alert-danger mt-3">
                        Usuario o contraseña incorrectos.
                    </div>
                }
                else if (Error == "bloqueado")
                {
                    <div class="alert alert-danger mt-3">
                        La cuenta está bloqueada temporalmente.
                    </div>
                }

            </form>

        </div>

        <div class="login-footer">
            © 2026 CAYCSOL. Todos los derechos reservados.
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}